# ==============================================================================
# WorkSense Frontend Environment Variables Example
# ==============================================================================
# Security Policy:
# - Only variables prefixed with NEXT_PUBLIC_ are bundled into client code.
# - NEVER put secrets, private keys, or service-role tokens in this file.
# - In local development, duplicate this file to .env.local
# ==============================================================================

# Backend API Base URL (required)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Public Configuration (Optional in Stage 1, Stage 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
