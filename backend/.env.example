# ==============================================================================
# WorkSense Backend Environment Configuration Example
# ==============================================================================
# Security Notice:
# 1. Never commit real credentials or private keys to version control.
# 2. Duplicate this file as .env for local development.
# 3. In production/demo, provide these via secure container environment variables.
# ==============================================================================

# Application Metadata
APP_NAME=WorkSense API
APP_ENV=development
APP_VERSION=1.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration (Optional in Stage 1, required in Stage 2+)
# Server-only: SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local AI Gateway Configuration (Optional in Stage 1, evaluated in Stage 14+)
QWEN_GATEWAY_URL=http://localhost:8001
QWEN_GATEWAY_AUTH_KEY=

# EnterPro Enterprise Orchestrator Configuration (Optional in Stage 1, Stage 7+)
ENTERPRO_API_URL=
ENTERPRO_WEBHOOK_SECRET=
